<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Firebase (Auth, Firestore, Storage) y validación del pago en Wompi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ingreso con huella (BiometricPrompt) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Ubicación para la dirección de entrega y la ubicación de la tienda -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- La cámara se usa a través de la app de cámara del sistema; no es obligatoria -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Android 11+: permite encontrar la app de cámara y la de mapas -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.RodaPartes">

        <!-- Transversal -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.RodaPartes.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.auth.LoginActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.RegisterActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.RecoverPasswordActivity" android:windowSoftInputMode="adjustResize" />

        <!-- Rol Comprador (naranja) -->
        <activity android:name=".ui.buyer.BuyerActivity" android:theme="@style/Theme.RodaPartes.Buyer" />
        <activity android:name=".ui.buyer.ProductDetailActivity" android:theme="@style/Theme.RodaPartes.Buyer" />
        <activity android:name=".ui.buyer.CheckoutActivity" android:theme="@style/Theme.RodaPartes.Buyer" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.buyer.PaymentActivity" android:theme="@style/Theme.RodaPartes.Buyer" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.buyer.EditProfileActivity" android:theme="@style/Theme.RodaPartes.Buyer" android:windowSoftInputMode="adjustResize" />

        <!-- Rol Vendedor (verde azulado) -->
        <activity android:name=".ui.seller.SellerActivity" android:theme="@style/Theme.RodaPartes.Seller" />
        <activity android:name=".ui.seller.ProductFormActivity" android:theme="@style/Theme.RodaPartes.Seller" android:windowSoftInputMode="adjustResize" />

        <!-- Rol Administrador (azul pizarra) -->
        <activity android:name=".ui.admin.AdminActivity" android:theme="@style/Theme.RodaPartes.Admin" />
        <activity android:name=".ui.admin.UserFormActivity" android:theme="@style/Theme.RodaPartes.Admin" android:windowSoftInputMode="adjustResize" />

        <!-- Comparte con la app de cámara el archivo donde debe guardar la foto -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
