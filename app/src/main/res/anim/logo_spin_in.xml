<?xml version="1.0" encoding="utf-8"?>
<!-- El anillo entra girando como una rueda que arranca -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="900"
    android:interpolator="@android:anim/decelerate_interpolator">
    <rotate
        android:fromDegrees="-160"
        android:toDegrees="0"
        android:pivotX="50%"
        android:pivotY="50%" />
    <scale
        android:fromXScale="0.6"
        android:fromYScale="0.6"
        android:toXScale="1"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
