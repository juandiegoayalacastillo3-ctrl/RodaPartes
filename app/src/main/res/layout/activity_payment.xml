<?xml version="1.0" encoding="utf-8"?>
<!--
    Pasarela de pagos ePayco (RF-PAG-03).
    Arriba el resumen; al tocar "Pagar" se abre el checkout oficial de ePayco dentro del WebView.
    Los datos de la tarjeta los recibe ePayco directamente: la app nunca los ve (RNF-SEG-02).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.buyer.PaymentActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/payment_title" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorPrimaryContainer" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Paso 1: resumen y botón de pago -->
        <ScrollView
            android:id="@+id/groupSummary"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/esp_l">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_thumb"
                    android:backgroundTint="@color/exito_claro"
                    android:drawablePadding="@dimen/esp_s"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:padding="@dimen/esp_m"
                    android:text="@string/payment_secure"
                    android:textColor="@color/exito"
                    android:textSize="14sp"
                    app:drawableStartCompat="@drawable/ic_shield_small" />

                <!-- Vista previa estilo tarjeta con el total -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="@dimen/esp_l"
                    android:background="@drawable/bg_card_preview"
                    android:padding="@dimen/esp_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_total"
                        android:textColor="@color/texto_3"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTotalBig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="@color/blanco"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        tools:text="$ 157.900" />

                    <TextView
                        android:id="@+id/tvInvoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:fontFamily="monospace"
                        android:textColor="@color/texto_3"
                        android:textSize="12sp"
                        tools:text="Factura RP-8F2K1" />

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom|end"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_card"
                        app:tint="@color/naranja" />
                </FrameLayout>

                <TextView
                    style="@style/RodaPartes.SectionTitle"
                    android:text="@string/payment_method" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_methods_epayco"
                    android:textAppearance="@style/TextAppearance.RodaPartes.Body"
                    android:textColor="@color/texto_2" />

                <TextView
                    android:id="@+id/tvItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/esp_l"
                    android:textAppearance="@style/TextAppearance.RodaPartes.Small"
                    tools:text="3 productos · Domicilio a Calle 80 # 69-22" />

                <TextView
                    android:id="@+id/tvTestNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/esp_l"
                    android:background="@drawable/bg_thumb"
                    android:backgroundTint="@color/info_claro"
                    android:padding="@dimen/esp_m"
                    android:text="@string/payment_test_note"
                    android:textColor="@color/info"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Paso 2: checkout de ePayco -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/esp_l"
        app:icon="@drawable/ic_shield"
        app:iconGravity="textStart"
        app:iconTint="@color/blanco"
        tools:text="Pagar $ 157.900 con ePayco" />
</LinearLayout>
