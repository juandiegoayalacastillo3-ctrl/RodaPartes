<?xml version="1.0" encoding="utf-8"?>
<!-- Reporte de ventas del administrador: cifras, tendencia, categorías y órdenes (RF-COM-02) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/esp_l">

        <!-- Periodo del reporte -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@+id/chipMonth"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_week" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_month" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSemester"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/period_semester" />
        </com.google.android.material.chip.ChipGroup>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_m"
            android:columnCount="2">

            <include
                android:id="@+id/statTotal"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="@dimen/esp_m" />

            <include
                android:id="@+id/statOrders"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="@dimen/esp_m" />

            <include
                android:id="@+id/statTicket"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp" />

            <include
                android:id="@+id/statCommission"
                layout="@layout/view_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp" />
        </GridLayout>

        <!-- Tendencia -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/esp_l">

                <TextView
                    android:id="@+id/tvChartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RodaPartes.Subtitle" />

                <com.rodapartes.app.ui.common.BarChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="@dimen/esp_m"
                    app:barColor="@color/pizarra"
                    app:barMutedColor="@color/pizarra_claro"
                    app:labelColor="@color/texto_3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ventas por categoría -->
        <TextView
            style="@style/RodaPartes.SectionTitle"
            android:text="@string/sales_by_category" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/llCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/esp_l"
                android:paddingTop="@dimen/esp_s"
                android:paddingEnd="@dimen/esp_l"
                android:paddingBottom="@dimen/esp_l" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Compras, retractos y reversiones -->
        <TextView
            style="@style/RodaPartes.SectionTitle"
            android:text="@string/sales_orders" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/esp_s"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipOrders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/llOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            style="@style/Widget.RodaPartes.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_m"
            android:text="@string/sales_export"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
