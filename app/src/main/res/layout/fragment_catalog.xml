<?xml version="1.0" encoding="utf-8"?>
<!-- Catálogo con búsqueda y filtros (RF-INI-02) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:orientation="vertical"
        android:paddingStart="@dimen/esp_l"
        android:paddingTop="@dimen/esp_m"
        android:paddingEnd="@dimen/esp_l"
        android:paddingBottom="@dimen/esp_m">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalog_title"
            android:textAppearance="@style/TextAppearance.RodaPartes.ToolbarTitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Widget.RodaPartes.TextInput.Search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_s"
            app:endIconContentDescription="@string/cd_scan"
            app:endIconDrawable="@drawable/ic_scan"
            app:endIconMode="custom"
            app:endIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/esp_l"
        android:paddingTop="@dimen/esp_s"
        android:paddingEnd="@dimen/esp_l"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/esp_l"
        android:paddingEnd="@dimen/esp_m">

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.RodaPartes.Small" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swCompatible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalog_only_compatible"
            android:textAppearance="@style/TextAppearance.RodaPartes.Small" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProducts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/esp_m"
            android:paddingEnd="@dimen/esp_m"
            android:paddingBottom="@dimen/esp_l" />

        <include
            android:id="@+id/empty"
            layout="@layout/view_empty"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
