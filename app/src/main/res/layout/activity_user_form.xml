<?xml version="1.0" encoding="utf-8"?>
<!-- Crear / editar / aprobar / eliminar usuario (RF-ADU-02 a 05) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.admin.UserFormActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/user_edit_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/esp_l">

            <LinearLayout
                android:id="@+id/groupHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="@dimen/esp_l">

                <TextView
                    android:id="@+id/tvInitials"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_avatar"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="MC" />

                <TextView
                    android:id="@+id/tvHeaderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/esp_s"
                    android:textAppearance="@style/TextAppearance.RodaPartes.Title"
                    tools:text="MotoCentro 80" />

                <TextView
                    android:id="@+id/tvHeaderStatus"
                    style="@style/RodaPartes.Badge"
                    android:layout_marginTop="@dimen/esp_xs"
                    tools:text="Pendiente" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/field_full_name"
                app:startIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_m"
                android:hint="@string/field_email"
                app:startIconDrawable="@drawable/ic_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_m"
                android:hint="@string/field_phone"
                app:startIconDrawable="@drawable/ic_phone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDocument"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_m"
                android:hint="@string/field_document_nit"
                app:startIconDrawable="@drawable/ic_badge">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDocument"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_m"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRole"
                    style="@style/Widget.RodaPartes.TextInput.Dropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/esp_s"
                    android:layout_weight="1"
                    android:hint="@string/field_role">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        app:simpleItems="@array/roles" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilStatus"
                    style="@style/Widget.RodaPartes.TextInput.Dropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/esp_s"
                    android:layout_weight="1"
                    android:hint="@string/field_status">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        app:simpleItems="@array/estados_usuario" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Documento del vendedor para aprobarlo (RF-ADU-04) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_l"
                android:clickable="true"
                android:focusable="true"
                app:strokeColor="?attr/colorPrimary">

                <LinearLayout
                    style="@style/RodaPartes.Row"
                    android:clickable="false">

                    <ImageView
                        android:layout_width="@dimen/icono"
                        android:layout_height="@dimen/icono"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_policy"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvRut"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/esp_m"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.RodaPartes.Body"
                        tools:text="RUT_motocentro80.pdf" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_view"
                        android:textColor="?attr/colorPrimary"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvAuditNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_m"
                android:drawablePadding="6dp"
                android:text="@string/user_audit_note"
                android:textAppearance="@style/TextAppearance.RodaPartes.Mini"
                app:drawableStartCompat="@drawable/ic_lock_small" />

            <!-- Acciones de aprobación -->
            <LinearLayout
                android:id="@+id/groupApproval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_l"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApprove"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/exito"
                    android:text="@string/action_approve"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconTint="@color/blanco" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSuspend"
                    style="@style/Widget.RodaPartes.Button.Danger"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/action_suspend" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.RodaPartes.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/esp_s"
                android:text="@string/user_delete"
                android:textColor="@color/peligro"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/peligro" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/esp_l"
        android:text="@string/action_save_changes" />
</LinearLayout>
