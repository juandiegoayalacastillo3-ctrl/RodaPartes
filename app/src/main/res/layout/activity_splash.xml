<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen: ConstraintLayout centrando el anillo de la marca y el nombre -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asfalto"
    tools:context=".ui.auth.SplashActivity">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:contentDescription="@string/cd_logo"
        android:src="@drawable/ic_logo_mark"
        app:layout_constraintBottom_toTopOf="@id/llWordmark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <LinearLayout
        android:id="@+id/llWordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/esp_l"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/tvTagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand_part1"
            android:textAppearance="@style/TextAppearance.RodaPartes.Display"
            android:textColor="@color/blanco"
            android:textSize="40sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand_part2"
            android:textAppearance="@style/TextAppearance.RodaPartes.Display"
            android:textColor="@color/naranja"
            android:textSize="40sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/esp_xs"
        android:text="@string/tagline"
        android:textAppearance="@style/TextAppearance.RodaPartes.Small"
        android:textColor="@color/texto_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llWordmark" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:indeterminate="true"
        app:indicatorColor="@color/naranja"
        app:trackColor="@color/asfalto_linea"
        app:trackCornerRadius="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/esp_xl"
        android:text="@string/version_label"
        android:textAppearance="@style/TextAppearance.RodaPartes.Mini"
        android:textColor="@color/asfalto_linea"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
