<?xml version="1.0" encoding="utf-8"?>
<!-- Usuario en la gestión de usuarios del admin. Correo y documento van enmascarados (RF-ADU-01). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/esp_s"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/esp_m">

        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="LG" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/esp_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.RodaPartes.Body"
                android:textStyle="bold"
                tools:text="Laura Gómez" />

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.RodaPartes.Small"
                tools:text="Comprador · la***@correo.com" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            style="@style/RodaPartes.Badge"
            tools:text="Activo" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/esp_xs"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron"
            app:tint="@color/texto_3" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
