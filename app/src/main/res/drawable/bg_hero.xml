<?xml version="1.0" encoding="utf-8"?>
<!-- Banner de inicio: fondo asfalto con los anillos de la portada del documento -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/asfalto" />
        </shape>
    </item>
    <item android:left="210dp" android:top="-50dp" android:right="-70dp" android:bottom="-50dp">
        <shape android:shape="oval">
            <stroke android:width="14dp" android:color="@color/naranja" />
        </shape>
    </item>
    <item android:left="248dp" android:top="-8dp" android:right="-30dp" android:bottom="-8dp">
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="@color/asfalto_linea" />
        </shape>
    </item>
</layer-list>
